{
  "name": "unhush",
  "version": "3.3.4",
  "description": "Voice input for Linux",
  "main": "electron/main.cjs",
  "homepage": "https://unhush.propriaworks.com",
  "type": "module",
  "scripts": {
    "copy-vad-assets": "bash scripts/copy-vad-assets.sh",
    "dev": "vite",
    "prebuild": "pnpm run copy-vad-assets",
    "build": "tsc && vite build",
    "electron": "electron . --no-sandbox",
    "electron:dev": "pnpm run copy-vad-assets && trap 'exit 0' INT TERM; concurrently --kill-others --success first 'vite' 'wait-on http://localhost:5173 && electron . --no-sandbox'",
    "package": "pnpm run build && electron-builder --linux AppImage deb rpm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:clipboard": "xvfb-run -a electron --no-sandbox electron/clipboardAccess.integration.cjs",
    "test:smoke": "bash scripts/smoke-test.sh"
  },
  "keywords": [
    "voice",
    "dictation",
    "whisper",
    "speech-to-text"
  ],
  "author": "Justin Briggs",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@ricky0123/vad-web": "^0.0.31",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "43.8.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "desktopName": "com.propriaworks.unhush",
  "build": {
    "appId": "com.propriaworks.unhush",
    "productName": "Unhush",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Justin Briggs <jtbr@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "deb": {
      "afterInstall": "scripts/postinstall.sh",
      "afterRemove": "scripts/postremove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "ydotool"
      ],
      "recommends": [
        "libappindicator3-1",
        "pulseaudio-utils"
      ],
      "fpm": [
        "--deb-suggests",
        "x11-utils",
        "--deb-suggests",
        "wl-clipboard"
      ]
    },
    "rpm": {
      "afterInstall": "scripts/postinstall.sh",
      "afterRemove": "scripts/postremove.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)"
      ],
      "fpm": [
        "--rpm-tag",
        "Suggests: xprop",
        "--rpm-tag",
        "Recommends: pulseaudio-utils",
        "--rpm-tag",
        "Recommends: ydotool",
        "--rpm-tag",
        "Recommends: wl-clipboard"
      ]
    },
    "pacman": {
      "afterInstall": "scripts/postinstall.sh",
      "afterRemove": "scripts/postremove.sh",
      "fpm": [
        "--after-upgrade",
        "scripts/postinstall.sh",
        "--pacman-optional-depends",
        "xorg-xprop: show the paste destination in the system tray (X11 only)",
        "--pacman-optional-depends",
        "libpulse: lower other apps' audio while recording (pactl)"
      ],
      "depends": [
        "gtk3",
        "nss",
        "libnotify",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "util-linux-libs",
        "ydotool",
        "wl-clipboard"
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon-warning.png"
    ],
    "afterPack": "scripts/strip-locales.cjs"
  }
}
